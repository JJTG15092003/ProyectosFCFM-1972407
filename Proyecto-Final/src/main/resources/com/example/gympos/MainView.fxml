<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.gympos.view.MainViewController"
            prefWidth="960.0" prefHeight="620.0"
            style="-fx-background-color: #1a1a2e;">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="20"
              style="-fx-background-color: #16213e; -fx-padding: 10 20 10 20;">
            <Label text="GymPOS"
                   style="-fx-text-fill: #e94560; -fx-font-size: 18px; -fx-font-weight: BOLD;"/>
            <Label fx:id="lblUsuarioActual"
                   text="Bienvenido"
                   style="-fx-text-fill: #888888; -fx-font-size: 12px;"/>
            <HBox HBox.hgrow="ALWAYS"/>
            <Button text="Cerrar Sesión"
                    onAction="#handleCerrarSesion"
                    style="-fx-background-color: #0f3460; -fx-text-fill: #aaaaaa;
                           -fx-border-radius: 4; -fx-background-radius: 4; -fx-cursor: hand;"/>
        </HBox>
    </top>

    <center>
        <TabPane fx:id="tabPane"
                 tabClosingPolicy="UNAVAILABLE"
                 style="-fx-background-color: #1a1a2e; -fx-tab-min-width: 130px;">

            <tabs>
                <Tab text="Clientes">
                    <fx:include source="ClienteView.fxml"/>
                </Tab>

                <Tab text="Membresías">
                    <fx:include source="MembresiaView.fxml"/>
                </Tab>

                <Tab text="Pagos">
                    <fx:include source="PagoView.fxml"/>
                </Tab>

                <Tab text="Control Acceso">
                    <fx:include source="AccesoView.fxml"/>
                </Tab>

                <Tab text="Reportes">
                    <fx:include source="ReporteView.fxml"/>
                </Tab>
            </tabs>
        </TabPane>
    </center>

    <bottom>
        <HBox style="-fx-background-color: #0f3460; -fx-padding: 4 16 4 16;">
            <Label fx:id="lblEstado"
                   text="Sistema listo."
                   style="-fx-text-fill: #888888; -fx-font-size: 11px;"/>
        </HBox>
    </bottom>

</BorderPane>
