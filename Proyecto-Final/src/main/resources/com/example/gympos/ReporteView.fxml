<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.gympos.view.ReporteViewController"
      style="-fx-background-color: #1a1a2e; -fx-padding: 24;">

    <Label text="Generador de Reportes"
           style="-fx-text-fill: #e0e0e0; -fx-font-size: 18px; -fx-font-weight: BOLD;"/>
    <Separator style="-fx-background-color: #0f3460;"/>

    <HBox spacing="12">
        <Button text=" Reporte de Ingresos" onAction="#handleReporteIngresos" prefWidth="200"
                style="-fx-background-color: #0f3460; -fx-text-fill: #e0e0e0; -fx-font-weight: BOLD;
                       -fx-border-radius: 4; -fx-background-radius: 4; -fx-cursor: hand;"/>
        <Button text=" Reporte de Clientes" onAction="#handleReporteClientes" prefWidth="200"
                style="-fx-background-color: #0f3460; -fx-text-fill: #e0e0e0; -fx-font-weight: BOLD;
                       -fx-border-radius: 4; -fx-background-radius: 4; -fx-cursor: hand;"/>
        <Button text=" Backup Completo" onAction="#handleBackup" prefWidth="200"
                style="-fx-background-color: #1a4a1a; -fx-text-fill: #4caf50; -fx-font-weight: BOLD;
                       -fx-border-radius: 4; -fx-background-radius: 4; -fx-cursor: hand;"/>
    </HBox>

    <HBox spacing="12" alignment="CENTER_LEFT">
        <ProgressIndicator fx:id="spinnerReporte" prefWidth="30" prefHeight="30"
                           visible="false"
                           style="-fx-progress-color: #e94560;"/>
        <Label fx:id="lblGenerando" text=""
               style="-fx-text-fill: #e94560; -fx-font-size: 12px;"/>
    </HBox>

    <Separator style="-fx-background-color: #0f3460;"/>

    <Label text="Vista previa del reporte:"
           style="-fx-text-fill: #aaaaaa; -fx-font-size: 11px;"/>
    <TextArea fx:id="areaReporte"
              editable="false"
              prefHeight="340"
              wrapText="true"
              style="-fx-background-color: #0a0a14; -fx-text-fill: #c8c8c8;
                     -fx-font-family: 'Courier New'; -fx-font-size: 12px;
                     -fx-border-color: #0f3460; -fx-border-radius: 3;
                     -fx-background-radius: 3;"/>

    <HBox spacing="8" alignment="CENTER_LEFT">
        <Label text="Guardado en:" style="-fx-text-fill: #555; -fx-font-size: 11px;"/>
        <Label fx:id="lblRutaArchivo" text="-"
               style="-fx-text-fill: #4caf50; -fx-font-size: 11px;"/>
    </HBox>

</VBox>
