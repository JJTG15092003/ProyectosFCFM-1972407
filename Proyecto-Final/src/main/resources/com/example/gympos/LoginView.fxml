<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="16.0"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.gympos.view.LoginViewController"
      prefWidth="380.0" prefHeight="300.0"
      style="-fx-background-color: #1a1a2e;">

    <padding>
        <Insets top="40" right="50" bottom="40" left="50"/>
    </padding>

    <Label text="GymPOS" style="-fx-text-fill: #e0e0e0; -fx-font-size: 28px; -fx-font-weight: BOLD;"/>
    <Label text="Sistema de Punto de Venta" style="-fx-text-fill: #888888; -fx-font-size: 12px;"/>

    <TextField fx:id="txtUsername"
               promptText="Usuario"
               style="-fx-background-color: #16213e; -fx-text-fill: #e0e0e0;
                      -fx-prompt-text-fill: #555; -fx-border-color: #0f3460;
                      -fx-border-radius: 4; -fx-background-radius: 4;
                      -fx-padding: 8 12 8 12;"/>

    <PasswordField fx:id="txtPassword"
                   promptText="Contraseña"
                   style="-fx-background-color: #16213e; -fx-text-fill: #e0e0e0;
                          -fx-prompt-text-fill: #555; -fx-border-color: #0f3460;
                          -fx-border-radius: 4; -fx-background-radius: 4;
                          -fx-padding: 8 12 8 12;"/>

    <Label fx:id="lblError"
           text=""
           style="-fx-text-fill: #e94560; -fx-font-size: 11px;"
           wrapText="true"/>

    <HBox spacing="10.0" alignment="CENTER">
        <Button text="Iniciar Sesión"
                onAction="#handleLogin"
                defaultButton="true"
                prefWidth="130"
                style="-fx-background-color: #e94560; -fx-text-fill: white;
                       -fx-font-weight: BOLD; -fx-border-radius: 4;
                       -fx-background-radius: 4; -fx-cursor: hand;"/>
        <Button text="Limpiar"
                onAction="#handleLimpiar"
                prefWidth="90"
                style="-fx-background-color: #0f3460; -fx-text-fill: #aaaaaa;
                       -fx-border-radius: 4; -fx-background-radius: 4; -fx-cursor: hand;"/>
    </HBox>

</VBox>
