<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Separator?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.gympos.view.ClienteViewController"
            style="-fx-background-color: #1a1a2e;">

    <left>
        <VBox spacing="10" prefWidth="280"
              style="-fx-background-color: #16213e; -fx-padding: 20;">

            <Label text="Gestión de Clientes"
                   style="-fx-text-fill: #e0e0e0; -fx-font-size: 15px; -fx-font-weight: BOLD;"/>
            <Separator style="-fx-background-color: #0f3460;"/>

            <Label text="Nombre" style="-fx-text-fill: #aaaaaa; -fx-font-size: 11px;"/>
            <TextField fx:id="txtNombre" promptText="Nombre"
                       style="-fx-background-color: #1a1a2e; -fx-text-fill: #e0e0e0;
                              -fx-prompt-text-fill: #555; -fx-border-color: #0f3460;
                              -fx-border-radius: 3; -fx-background-radius: 3;"/>

            <Label text="Apellido" style="-fx-text-fill: #aaaaaa; -fx-font-size: 11px;"/>
            <TextField fx:id="txtApellido" promptText="Apellido"
                       style="-fx-background-color: #1a1a2e; -fx-text-fill: #e0e0e0;
                              -fx-prompt-text-fill: #555; -fx-border-color: #0f3460;
                              -fx-border-radius: 3; -fx-background-radius: 3;"/>

            <Label text="Email" style="-fx-text-fill: #aaaaaa; -fx-font-size: 11px;"/>
            <TextField fx:id="txtEmail" promptText="correo@ejemplo.com"
                       style="-fx-background-color: #1a1a2e; -fx-text-fill: #e0e0e0;
                              -fx-prompt-text-fill: #555; -fx-border-color: #0f3460;
                              -fx-border-radius: 3; -fx-background-radius: 3;"/>

            <Label text="Teléfono" style="-fx-text-fill: #aaaaaa; -fx-font-size: 11px;"/>
            <TextField fx:id="txtTelefono" promptText="10 dígitos"
                       style="-fx-background-color: #1a1a2e; -fx-text-fill: #e0e0e0;
                              -fx-prompt-text-fill: #555; -fx-border-color: #0f3460;
                              -fx-border-radius: 3; -fx-background-radius: 3;"/>

            <Separator style="-fx-background-color: #0f3460;"/>

            <HBox spacing="6">
                <Button text="Registrar" onAction="#handleRegistrar" prefWidth="120"
                        style="-fx-background-color: #e94560; -fx-text-fill: white;
                               -fx-font-weight: BOLD; -fx-border-radius: 3;
                               -fx-background-radius: 3; -fx-cursor: hand;"/>
                <Button text=" Actualizar" onAction="#handleActualizar" prefWidth="120"
                        style="-fx-background-color: #0f3460; -fx-text-fill: #e0e0e0;
                               -fx-border-radius: 3; -fx-background-radius: 3; -fx-cursor: hand;"/>
            </HBox>
            <HBox spacing="6">
                <Button text=" Eliminar" onAction="#handleEliminar" prefWidth="120"
                        style="-fx-background-color: #3a0f0f; -fx-text-fill: #e94560;
                               -fx-border-radius: 3; -fx-background-radius: 3; -fx-cursor: hand;"/>
                <Button text="✖ Limpiar" onAction="#handleLimpiar" prefWidth="120"
                        style="-fx-background-color: #222; -fx-text-fill: #888;
                               -fx-border-radius: 3; -fx-background-radius: 3; -fx-cursor: hand;"/>
            </HBox>

            <!-- Mensaje de estado -->
            <Label fx:id="lblStatus" text="" wrapText="true"
                   style="-fx-text-fill: #4caf50; -fx-font-size: 11px;"/>
        </VBox>
    </left>

    <center>
        <VBox spacing="10" style="-fx-padding: 20;">

            <HBox spacing="8" alignment="CENTER_LEFT">
                <TextField fx:id="txtBuscar" promptText="Buscar por nombre..."
                           prefWidth="280"
                           style="-fx-background-color: #16213e; -fx-text-fill: #e0e0e0;
                                  -fx-prompt-text-fill: #555; -fx-border-color: #0f3460;
                                  -fx-border-radius: 3; -fx-background-radius: 3;"/>
                <Button text="Buscar" onAction="#handleBuscar"
                        style="-fx-background-color: #0f3460; -fx-text-fill: #e0e0e0;
                               -fx-border-radius: 3; -fx-background-radius: 3; -fx-cursor: hand;"/>
                <Button text="Mostrar todos" onAction="#handleMostrarTodos"
                        style="-fx-background-color: #1a1a2e; -fx-text-fill: #888;
                               -fx-border-radius: 3; -fx-background-radius: 3; -fx-cursor: hand;"/>
            </HBox>

            <TableView fx:id="tablaClientes" VBox.vgrow="ALWAYS"
                       style="-fx-background-color: #16213e; -fx-border-color: #0f3460;">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
                    <TableColumn fx:id="colNombre" text="Nombre" prefWidth="130"/>
                    <TableColumn fx:id="colApellido" text="Apellido" prefWidth="130"/>
                    <TableColumn fx:id="colEmail" text="Email" prefWidth="200"/>
                    <TableColumn fx:id="colTelefono" text="Telefono" prefWidth="110"/>
                    <TableColumn fx:id="colPuntos" text="Puntos" prefWidth="80"/>
                </columns>
                <placeholder>
                    <Label text="Sin clientes registrados."
                           style="-fx-text-fill: #555;"/>
                </placeholder>
            </TableView>

        </VBox>
    </center>

</BorderPane>
