<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.gympos.view.PagoViewController"
            style="-fx-background-color: #1a1a2e;">

    <left>
        <VBox spacing="10" prefWidth="280"
              style="-fx-background-color: #16213e; -fx-padding: 20;">

            <Label text="Procesar Pago"
                   style="-fx-text-fill: #e0e0e0; -fx-font-size: 15px; -fx-font-weight: BOLD;"/>
            <Separator style="-fx-background-color: #0f3460;"/>

            <Label text="ID de Cliente" style="-fx-text-fill: #aaaaaa; -fx-font-size: 11px;"/>
            <TextField fx:id="txtIdCliente" promptText="ID del cliente"
                       style="-fx-background-color: #1a1a2e; -fx-text-fill: #e0e0e0;
                              -fx-prompt-text-fill: #555; -fx-border-color: #0f3460;
                              -fx-border-radius: 3; -fx-background-radius: 3;"/>

            <Label text="Membresía" style="-fx-text-fill: #aaaaaa; -fx-font-size: 11px;"/>
            <ComboBox fx:id="comboMembresia" prefWidth="240"
                      promptText="Selecciona membresía"
                      style="-fx-background-color: #1a1a2e; -fx-border-color: #0f3460;
                             -fx-border-radius: 3;"/>

            <Label text="Método de Pago" style="-fx-text-fill: #aaaaaa; -fx-font-size: 11px;"/>
            <ComboBox fx:id="comboMetodo" prefWidth="240"
                      style="-fx-background-color: #1a1a2e; -fx-border-color: #0f3460;
                             -fx-border-radius: 3;"/>

            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="Monto:" style="-fx-text-fill: #aaaaaa; -fx-font-size: 11px;"/>
                <Label fx:id="lblMonto" text="0.00"
                       style="-fx-text-fill: #e94560; -fx-font-size: 16px; -fx-font-weight: BOLD;"/>
            </HBox>

            <Separator style="-fx-background-color: #0f3460;"/>

            <Button text=" Procesar Pago" onAction="#handleProcesar" prefWidth="240"
                    style="-fx-background-color: #e94560; -fx-text-fill: white;
                           -fx-font-weight: BOLD; -fx-border-radius: 3;
                           -fx-background-radius: 3; -fx-cursor: hand;"/>

            <HBox alignment="CENTER" spacing="8">
                <ProgressIndicator fx:id="spinnerPago" prefWidth="28" prefHeight="28"
                                   visible="false"
                                   style="-fx-progress-color: #e94560;"/>
                <Label fx:id="lblProcesando" text="Procesando..."
                       visible="false"
                       style="-fx-text-fill: #e94560; -fx-font-size: 12px;"/>
            </HBox>

            <Label fx:id="lblStatus" text="" wrapText="true"
                   style="-fx-text-fill: #4caf50; -fx-font-size: 11px;"/>
        </VBox>
    </left>

    <center>
        <VBox spacing="10" style="-fx-padding: 20;">

            <!-- Resumen rápido -->
            <HBox spacing="30" alignment="CENTER_LEFT">
                <VBox>
                    <Label text="INGRESOS MES ACTUAL"
                           style="-fx-text-fill: #555; -fx-font-size: 10px;"/>
                    <Label fx:id="lblIngresosMes" text="0.00"
                           style="-fx-text-fill: #4caf50; -fx-font-size: 22px; -fx-font-weight: BOLD;"/>
                </VBox>
                <VBox>
                    <Label text="TOTAL PAGOS"
                           style="-fx-text-fill: #555; -fx-font-size: 10px;"/>
                    <Label fx:id="lblTotalPagos" text="0"
                           style="-fx-text-fill: #e0e0e0; -fx-font-size: 22px; -fx-font-weight: BOLD;"/>
                </VBox>
            </HBox>

            <TableView fx:id="tablaPagos" VBox.vgrow="ALWAYS"
                       style="-fx-background-color: #16213e; -fx-border-color: #0f3460;">
                <columns>
                    <TableColumn fx:id="colId" text="Folio" prefWidth="80"/>
                    <TableColumn fx:id="colCliente" text="Cliente" prefWidth="160"/>
                    <TableColumn fx:id="colMonto" text="Monto" prefWidth="90"/>
                    <TableColumn fx:id="colMetodo" text="Método" prefWidth="120"/>
                    <TableColumn fx:id="colEstado" text="Estado" prefWidth="100"/>
                    <TableColumn fx:id="colFechaHora" text="Fecha/Hora" prefWidth="140"/>
                </columns>
            </TableView>
        </VBox>
    </center>

</BorderPane>